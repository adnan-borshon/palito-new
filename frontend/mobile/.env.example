# Only enable in a development build configured with your Firebase native app files.
EXPO_PUBLIC_FIREBASE_NATIVE_ENABLED=false
EXPO_PUBLIC_PALITO_API_ORIGIN=
# Required when native Firebase is enabled; service files stay ignored.
PALITO_ANDROID_PACKAGE=
PALITO_IOS_BUNDLE=
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=
