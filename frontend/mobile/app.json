{
  "expo": {
    "name": "Palito",
    "slug": "palito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "palito",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/palito/images/palito-mark.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/palito/fonts/AnekBangla-Regular.ttf",
            "./assets/palito/fonts/AnekBangla-Medium.ttf",
            "./assets/palito/fonts/AnekBangla-SemiBold.ttf",
            "./assets/palito/fonts/AnekBangla-Bold.ttf",
            "./assets/palito/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/palito/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/palito/fonts/PlusJakartaSans-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
