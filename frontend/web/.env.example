# Public Firebase web configuration (never place Admin credentials here).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Server-only backend origin. Production requires HTTPS and same-origin proxy.
PALITO_API_ORIGIN=http://127.0.0.1:4000
# Local dev only, impossible in production bundles.
NEXT_PUBLIC_AUTH_EMULATOR=false
