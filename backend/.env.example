# Documentation template only. npm run setup:dev generates random local credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
POSTGRES_USER=palito_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=palito_dev
POSTGRES_PORT=5432
DATABASE_ADMIN_URL=postgresql://palito_dev:replace-with-a-random-local-password@127.0.0.1:5432/palito_dev
MIGRATION_DATABASE_URL=postgresql://palito_migrator:replace-with-a-separate-random-password@127.0.0.1:5432/palito_dev?schema=palito
DATABASE_URL=postgresql://palito_runtime:replace-with-another-random-password@127.0.0.1:5432/palito_dev?schema=palito
# Enable only for a disposable local development/test database.
SEED_SYNTHETIC=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=info
BODY_LIMIT_BYTES=262144
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
DATABASE_TIMEOUT_MS=2000
SWAGGER_ENABLED=true
# Disabled is the safe default. firebase uses Application Default Credentials.
# emulator requires a demo-* project, local host and non-production NODE_ENV.
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=demo-palito
WEB_ORIGIN=http://localhost:3000
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
DEMO_MODE=false
# Explicit no-charge booking pilot only. No payment is claimed or processed.
HEALTHCARE_NO_CHARGE_PILOT=false
# M5 worker & notification channels (no live telecom SMS provider configured).
NOTIFICATION_CHANNEL_MODE=in-app-only
WORKER_ENABLED=false
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=25
# M6 financial sandbox (forbidden in production; never represents real funds).
FINANCE_SANDBOX_ENABLED=false
PAYMENT_PROVIDER=disabled
# SANDBOX_WEBHOOK_SECRET=replace-with-local-only-webhook-secret
