{
  "name": "palito",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.3.0"
  },
  "workspaces": [
    "frontend/mobile",
    "frontend/web",
    "frontend/shared",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace @palito/mobile",
    "android": "npm run android --workspace @palito/mobile",
    "ios": "npm run ios --workspace @palito/mobile",
    "web": "npm run web --workspace @palito/mobile",
    "dev:web": "npm run dev --workspace @palito/web",
    "build:web": "npm run build --workspace @palito/web",
    "start:web": "npm run start --workspace @palito/web",
    "lint": "npm run lint --workspace @palito/mobile",
    "lint:web": "npm run lint --workspace @palito/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "doctor": "npm run doctor --workspace @palito/mobile",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test --workspace @palito/shared",
    "test:mobile": "npm run test --workspace @palito/mobile",
    "export:web": "npm run export:web --workspace @palito/mobile",
    "dev:backend": "npm run dev --workspace @palito/backend",
    "build:backend": "npm run build --workspace @palito/backend",
    "lint:backend": "npm run lint --workspace @palito/backend",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:backend": "npm run test --workspace @palito/backend",
    "test:backend:integration": "npm run test:integration --workspace @palito/backend",
    "setup:backend": "npm run setup:dev --workspace @palito/backend",
    "db:bootstrap": "npm run db:bootstrap --workspace @palito/backend",
    "db:migrate": "npm run migrate:deploy --workspace @palito/backend",
    "db:seed": "npm run db:seed --workspace @palito/backend"
  }
}
